---
// /hackathon: Q-Hack 2027 (DESIGN.md HACK-1, ADR-0009).
//
// A terminal that somebody else is typing into: the Q-hack lockup as a body
// of characters, a laptop that forms, opens and gets taken over, the
// programme as a log, the aftermovie, a roll of photos, the questions as a
// terminal conversation and the pitch to partner companies
// (components/qhack/QhackPage.astro). The page brings its own dress of the
// site header (QhackHeader.astro) and ends in the white site footer.
//
// All copy, the dates, the apply state, partners, the programme, photos and
// the partner pitch load at build time from the page-hackathon global, the
// questions from the FAQs with Page set to Hackathon (src/lib/content.ts).
// The laptop model and its stickers are design assets under
// public/hackathon/; the film and the partner logos are fixed /media keys
// (src/assets/media/hackathon.ts). JetBrains Mono, the page's second face,
// is loaded by this page alone.
import Base from "../layouts/Base.astro";
import QhackHeader from "../components/qhack/QhackHeader.astro";
import QhackPage from "../components/qhack/QhackPage.astro";
import { Font } from "../lib/astro-assets";
import { getFaqs, getPageContent } from "../lib/content";

const { hackathon } = await getPageContent();
const faqs = (await getFaqs()).filter((faq) => faq.page === "hackathon");
---

<Base
  title={hackathon.title}
  description={hackathon.metaDescription}
  ogImage="/media/og-q-hack-2027.jpg"
  ogImageAlt="Q-hack, University of Mannheim"
  livePreviewGlobal="page-hackathon"
>
  <Font slot="head" cssVariable="--font-jetbrains-mono" preload />
  <QhackHeader slot="header" />
  <QhackPage content={hackathon} faqs={faqs} />
</Base>
