---
// /ticket-categories: the 2027 ticket page (DESIGN.md TICKETS-1). One
// ticket model from the page-tickets global (2027 groups) drives the
// ticket picker (the list and the one card picked) and Compare tickets;
// the discount phases open the page as the homepage's four cards. Every
// buy button links to the one shop URL in that global
// (offer.purchaseHref); no embeds. tickets.client.ts adds the picker,
// the compare pickers and the touch/keyboard pressed state on top of
// complete static HTML.
import Base from "../layouts/Base.astro";
import TicketHero from "../components/tickets/TicketHero.astro";
import TicketIncluded from "../components/tickets/TicketIncluded.astro";
import TicketCompare from "../components/tickets/TicketCompare.astro";
import { getPageContent } from "../lib/content";
import { salePriceLabel } from "../components/tickets/ticket-model";
import { EVENTS } from "../lib/analytics/events";

const { ticketCategories: page } = await getPageContent();
// The active discount phase names the sale price everywhere it is read out.
const priceLabel = salePriceLabel(page.phases);
---

<Base
  title={page.title}
  description={page.metaDescription}
  livePreviewGlobal="page-tickets"
  pageEvent={{ name: EVENTS.ticket_page_viewed }}
>
  <div class="ticket-page" data-ticket-page>
    <TicketHero hero={page.hero} phases={page.phases} />
    <TicketIncluded
      offer={page.offer}
      included={page.included}
      phases={page.phases}
      priceLabel={priceLabel}
    />
    <TicketCompare page={page} />
    <div class="t-page-fade" aria-hidden="true"></div>
  </div>
</Base>

<script>
  import { initTicketPage } from "../components/tickets/tickets.client";

  initTicketPage();
</script>
