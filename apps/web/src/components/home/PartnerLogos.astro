---
// Partners (DESIGN.md HOME-1, after the 2027 concept mockup): the
// heading names the edition the logos belong to ("Partners of Q-Summit
// 2026", from the content, so last year's partners are never shown as
// this year's), a link to all partners, then one row per group (Startups,
// Corporates, Network): its number, name and line at the left, a running
// strip of logos at the right.
//
// Each logo sits on a carrier in the header's dark liquid glass: rounded,
// a fine lit rim, restrained depth, and inside it a light plate, because
// most partner logos are drawn dark for light ground. The logos stay
// exactly as their owners made them (never recolored, cropped or rounded);
// every logo gets the same optical area, so a wide wordmark and a square
// mark carry the same weight.
//
// Smooth by construction: a strip is two identical groups moving by
// translate3d(-50%) on its own layer; nothing filters it, and its soft ends
// are one static mask on the row, so the logos fade in from the row's name
// and out towards the window's edge; logos are swapped
// for copies at their drawn size once the page is idle (home.client.ts);
// the strip stops on hover and keyboard focus, with the Pause button and
// off screen. The repeats are decorative, so each partner is met once by
// keyboard and screen reader. Reduced motion shows plain rows that scroll
// sideways by hand.
import "./home-theme.css";

export interface PartnerLogo {
  name: string;
  href: string;
  src: string;
  width: number;
  height: number;
}

export interface PartnerLogoGroup {
  label: string;
  description?: string;
  logos: PartnerLogo[];
}

interface Props {
  heading?: string;
  groups: PartnerLogoGroup[];
  cta?: { label: string; href: string };
}

const { heading, groups, cta } = Astro.props;

// Mirrors the CSS below (rem = 16px): carrier 11rem wide, 0.75rem gap.
const CARRIER_PX = 176;
const GAP_PX = 12;
const GROUP_MIN_PX = 2400;
const SPEED_PX_S = 28;

const LOGO_AREA = 2500;
const LOGO_MAX_W = 116;
const LOGO_MAX_H = 44;

function logoBox(logo: PartnerLogo): { width: number; height: number } {
  const ratio = logo.width / logo.height;
  let width = Math.sqrt(LOGO_AREA * ratio);
  let height = Math.sqrt(LOGO_AREA / ratio);
  const fit = Math.min(1, LOGO_MAX_W / width, LOGO_MAX_H / height);
  width *= fit;
  height *= fit;
  return { width: Math.round(width), height: Math.round(height) };
}

const rows = groups.map((group, index) => {
  const setWidth = group.logos.length * (CARRIER_PX + GAP_PX);
  const repeats =
    setWidth > 0 ? Math.max(1, Math.ceil(GROUP_MIN_PX / setWidth)) : 1;
  return {
    ...group,
    repeats,
    reverse: index % 2 === 1,
    seconds: Math.round((setWidth * repeats) / SPEED_PX_S),
    logos: group.logos.map((logo) => ({ ...logo, box: logoBox(logo) })),
  };
});

// "Partners of Q-Summit 2026": the edition in ice on its own line.
const split = heading ? /^(.*\bof)\s+(.+)$/i.exec(heading) : null;
---

{
  rows.length > 0 && (
    <section
      class="h-section pl"
      id="partners"
      aria-labelledby={heading ? "home-partners-title" : undefined}
      aria-label={heading ? undefined : "Partners"}
      data-marquee
    >
      <div class="h-shell">
        <div class="pl-head">
          {heading && (
            <h2
              id="home-partners-title"
              class="h-title pl-title"
              data-lp="partnerBand.heading"
              data-h-reveal
            >
              {split ? (
                <>
                  {split[1]}
                  <br />
                  <span class="h-accent">{split[2]}</span>
                </>
              ) : (
                heading
              )}
            </h2>
          )}
          <div class="pl-actions" data-h-reveal>
            <button
              type="button"
              class="pl-pause"
              aria-pressed="false"
              data-marquee-toggle
            >
              <span class="pl-pause-icon" aria-hidden="true" />
              <span
                data-marquee-label
                data-pause="Pause logos"
                data-play="Play logos"
              >
                Pause logos
              </span>
            </button>
            {cta && (
              <a
                class="h-btn"
                href={cta.href}
                data-lp="partnerBand.cta"
                data-lp-href="partnerBand.cta.href"
              >
                <span data-lp-label>{cta.label}</span>
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M4 12h15M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )}
          </div>
        </div>

        <div class="pl-rows">
          {rows.map((row, r) => (
            <div class="pl-row" data-h-reveal style={`--h-i: ${r}`}>
              <div class="pl-label">
                <h3>{row.label}</h3>
                {row.description && <p>{row.description}</p>}
              </div>
              <div class="pl-viewport">
                <div
                  class:list={["pl-track", { "is-reverse": row.reverse }]}
                  style={`--marquee-seconds: ${row.seconds}s`}
                >
                  {[0, 1].map((half) => (
                    <div
                      class="pl-group"
                      aria-hidden={half === 1 ? "true" : undefined}
                    >
                      {Array.from({ length: row.repeats }).map((_, repeat) => {
                        const real = half === 0 && repeat === 0;
                        return (
                          <ul
                            class="pl-logos"
                            aria-label={
                              real ? `${row.label} partners` : undefined
                            }
                            aria-hidden={
                              !real && half === 0 ? "true" : undefined
                            }
                          >
                            {row.logos.map((logo) => {
                              const image = (
                                <img
                                  src={logo.src}
                                  alt=""
                                  width={logo.box.width}
                                  height={logo.box.height}
                                  decoding="async"
                                />
                              );
                              return (
                                <li>
                                  {real ? (
                                    <a
                                      class="pl-carrier"
                                      href={logo.href}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      aria-label={`${logo.name} (opens in a new tab)`}
                                    >
                                      <span class="pl-plate">{image}</span>
                                    </a>
                                  ) : (
                                    <span class="pl-carrier" tabindex="-1">
                                      <span class="pl-plate">{image}</span>
                                    </span>
                                  )}
                                </li>
                              );
                            })}
                          </ul>
                        );
                      })}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  /* DESIGN.md HOME-1 */
  .pl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: clamp(var(--space-lg), 5vw, 3.5rem);
  }

  .pl-title {
    font-size: clamp(2.5rem, 5.4vw, 5.25rem);
  }

  .pl-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .pl-pause {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 var(--space-sm);
    border: 0;
    border-radius: var(--radius-ticket-button);
    background: transparent;
    color: var(--h-text-soft);
    font: inherit;
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (hover: hover) {
    .pl-pause:hover {
      color: var(--color-white);
    }
  }

  .pl-pause:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: 2px;
  }

  /* Pause: two bars; play: a triangle. */
  .pl-pause-icon {
    width: 0.7rem;
    height: 0.8rem;
    border-inline: 0.22rem solid currentColor;
  }

  .pl-pause[aria-pressed="true"] .pl-pause-icon {
    width: 0;
    height: 0;
    border-block: 0.42rem solid transparent;
    border-left: 0.7rem solid currentColor;
    border-right: 0;
  }

  .pl-row {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr);
    align-items: center;
    border-bottom: 1px solid;
    border-image: var(--h-fade-x) 1;
  }

  /* Hinted lines between the groups only: the list's outer edges stay
     open, so the section never ends on a line. */
  .pl-row:last-child {
    border-bottom: 0;
  }

  .pl-label {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-md) var(--space-md) var(--space-md) 0;
  }

  .pl-label h3 {
    margin: 0;
    font-size: var(--text-size-large);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.01em;
  }

  .pl-label p {
    margin: 0;
    color: var(--h-text-faint);
    font-size: var(--text-size-small);
  }

  .pl-viewport {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-md);
    -webkit-mask: linear-gradient(
      90deg,
      transparent,
      var(--color-black) 12%,
      var(--color-black) 80%,
      transparent
    );
    mask: linear-gradient(
      90deg,
      transparent,
      var(--color-black) 12%,
      var(--color-black) 80%,
      transparent
    );
  }

  .pl-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .pl-group,
  .pl-logos {
    display: flex;
    gap: var(--space-xs);
  }

  .pl-group {
    padding-right: var(--space-xs);
  }

  .pl-logos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The carrier: dark liquid glass, rounded, a fine lit rim. */
  .pl-carrier {
    display: block;
    width: 11rem;
    padding: 0.35rem;
    border-radius: var(--radius-ticket-panel);
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--color-ticket-sky) 22%, transparent),
      color-mix(in srgb, var(--color-navy) 30%, transparent)
    );
    box-shadow:
      inset 0 0 0 1px
        color-mix(in srgb, var(--color-ticket-ice) 20%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 34%, transparent),
      0 14px 26px -20px var(--color-ticket-midnight);
    transition: transform var(--duration-hover) var(--ease-snappy);
  }

  /* Pure white, the white most logo files are drawn on, so a logo with
     its own white ground melts into the plate with no visible edge. */
  .pl-plate {
    display: grid;
    place-items: center;
    height: 4.25rem;
    border-radius: var(--radius-ticket-button);
    background: var(--color-white);
  }

  .pl-plate img {
    display: block;
    max-width: 82%;
    height: auto;
    object-fit: contain;
  }

  @media (hover: hover) {
    a.pl-carrier:hover {
      transform: translateY(-2px);
    }
  }

  a.pl-carrier:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pl-track {
      animation: pl-run var(--marquee-seconds) linear infinite;
    }

    .pl-track.is-reverse {
      animation-direction: reverse;
    }

    .pl-viewport:hover .pl-track,
    .pl-viewport:focus-within .pl-track,
    .pl[data-paused] .pl-track,
    .pl[data-offscreen] .pl-track {
      animation-play-state: paused;
    }
  }

  @keyframes pl-run {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-viewport {
      overflow-x: auto;
    }

    .pl-group[aria-hidden="true"],
    .pl-logos[aria-hidden="true"],
    .pl-pause {
      display: none;
    }

    .pl-carrier {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .pl-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .pl-label {
      padding: var(--space-md) 0 0;
    }

    .pl-viewport {
      margin-inline: calc(-1 * var(--h-gutter));
      border-left: 0;
    }

    .pl-carrier {
      width: 9.5rem;
    }

    .pl-plate {
      height: 3.75rem;
    }
  }
</style>
