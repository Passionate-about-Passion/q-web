---
// The homepage countdown (DESIGN.md HOME-1): days, hours, minutes and
// seconds until the first conference day begins in Mannheim (00:00 Europe/
// Berlin on home.event.startDate; never presented as a door time). One
// pane of dark liquid glass across the hero: the countdown's name at the
// left, four columns split by hairlines, large white figures of one width
// (tabular numbers, so nothing jitters), the seconds in ice, and a clear
// label under each. A figure that changes rolls in from below.
//
// The target is one UTC instant computed at build time (lib/countdown.ts),
// so the visitor's time zone and daylight saving never matter, and
// countdown.client.ts always recomputes from that instant and the clock
// (correct again the moment a sleeping tab returns, stops at zero). No
// number is rendered at build: the figures hold their place hidden until
// the script fills them. Without JavaScript the display is hidden; the
// dates are in the hero. Screen readers get one sentence, not the figures.
import type { HomeCountdown } from "../../lib/content";
import Unbroken from "./Unbroken.astro";
import {
  COUNTDOWN_UNITS,
  EVENT_TIME_ZONE,
  remainingUntil,
  zonedDayStart,
} from "../../lib/countdown";

interface Props {
  /** First conference day, yyyy-mm-dd. */
  startDate: string;
  labels: HomeCountdown;
}

const { startDate, labels } = Astro.props;
const target = zonedDayStart(startDate, EVENT_TIME_ZONE);

const dayDigits = Math.max(
  2,
  String(remainingUntil(target, Date.now()).days).length,
);
const unitLabels = {
  days: labels.daysLabel,
  hours: labels.hoursLabel,
  minutes: labels.minutesLabel,
  seconds: labels.secondsLabel,
};
const units = COUNTDOWN_UNITS.map((unit) => ({
  unit,
  digits: unit === "days" ? dayDigits : 2,
  label: unitLabels[unit],
}));
---

<div
  class="hcd h-glass"
  role="group"
  aria-label={labels.label}
  data-countdown
  data-target={target}
  data-spoken={labels.spokenLabel}
>
  <p class="u-visually-hidden" data-countdown-spoken></p>
  <p class="hcd-name" aria-hidden="true" data-lp="countdown.label">
    <Unbroken text={labels.label} />
  </p>
  <div class="hcd-row" aria-hidden="true" data-countdown-row>
    {
      units.map(({ unit, digits, label }) => (
        <div class:list={["hcd-unit", `is-${unit}`]} data-unit={unit}>
          <span class="hcd-digits" data-digits>
            {Array.from({ length: digits }).map(() => (
              <span class="hcd-digit" data-digit>
                0
              </span>
            ))}
          </span>
          <span class="hcd-label">{label}</span>
        </div>
      ))
    }
  </div>
  <p class="hcd-live" data-countdown-live hidden>{labels.liveLabel}</p>
</div>
<noscript>
  <style is:inline>
    .hcd {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import "./countdown.client";
</script>

<style>
  /* DESIGN.md HOME-1 */
  .hcd {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--space-xs);
    padding: clamp(var(--space-sm), 2vw, 1.4rem)
      clamp(var(--space-sm), 2.6vw, var(--space-lg));
  }

  .hcd-name {
    margin: 0;
    color: var(--color-ticket-ice);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.16em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .hcd-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .hcd-row[hidden] {
    display: none;
  }

  .hcd-unit {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    padding-inline: clamp(var(--space-2xs), 2vw, var(--space-md));
  }

  /* Hinted dividers: they fade out before the pane's edges. */
  .hcd-unit + .hcd-unit {
    border-left: 1px solid;
    border-image: var(--h-fade-y) 1;
  }

  .hcd-digits {
    display: flex;
    overflow: clip;
    color: var(--color-white);
    font-size: clamp(2.1rem, 5vw, 4.25rem);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .hcd-unit.is-seconds .hcd-digits {
    color: var(--color-ticket-ice);
  }

  .hcd-digit {
    display: inline-block;
    min-width: 0.6em;
    text-align: center;
  }

  .hcd:not([data-state]) .hcd-digits {
    visibility: hidden;
  }

  .hcd-label {
    color: color-mix(in srgb, var(--color-white) 80%, transparent);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hcd-live {
    grid-column: 1;
    margin: 0;
    color: var(--color-white);
    font-size: var(--text-size-large);
    font-weight: var(--font-weight-extrabold);
  }

  @media (max-width: 767px) {
    .hcd {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xs);
    }

    .hcd-name {
      max-width: none;
    }

    .hcd-unit {
      padding-inline: 0.6rem;
    }

    .hcd-unit:first-child {
      padding-left: 0;
    }

    .hcd-live {
      grid-column: 1;
    }
  }

  @media (max-width: 479px) {
    .hcd-label {
      font-size: min(var(--text-size-tiny), 2.9vw);
      letter-spacing: 0.06em;
    }
  }
</style>
