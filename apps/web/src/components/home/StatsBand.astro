---
// Key figures under the hero (DESIGN.md HOME-1, after the 2027 concept
// mockup): one row of four, split by hairlines, each a large heavy figure (its suffix in ice) and an uppercase label. The
// final figure is in the HTML; home-stage.client.ts counts it up once,
// in under a second, as soon as a quarter of it is visible.
import type { PageStat } from "../../lib/content";
import "./home-theme.css";

interface Props {
  heading: string;
  stats: PageStat[];
}

const { heading, stats } = Astro.props;
const fmt = new Intl.NumberFormat("en-US");

const items = stats.map((stat) => {
  // "1500" -> 1,500; "30+" -> 30 and "+".
  const match = /^([\d.,]+)(.*)$/.exec(stat.value.trim());
  const number = match ? Number(match[1]!.replace(/[.,]/g, "")) : NaN;
  return {
    label: stat.label,
    number: Number.isFinite(number) ? number : null,
    text: Number.isFinite(number) ? fmt.format(number) : stat.value,
    suffix: match ? match[2]!.trim() : "",
  };
});
---

<section class="hs" aria-labelledby="home-stats-title">
  <h2 id="home-stats-title" class="u-visually-hidden" data-lp="stats.heading">
    {heading}
  </h2>
  <ul class="h-shell hs-row">
    {
      items.map((item, i) => (
        <li class="hs-item" data-h-reveal style={`--h-i: ${i}`}>
          <span class="hs-figure">
            <span data-count-to={item.number ?? undefined}>{item.text}</span>
            {item.suffix && <span class="h-accent">{item.suffix}</span>}
          </span>
          <span class="hs-label">{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* DESIGN.md HOME-1 */
  .hs-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block: 0;
    padding: 0;
    list-style: none;
  }

  .hs-item {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: clamp(var(--space-lg), 5vw, 3.5rem)
      clamp(var(--space-sm), 2vw, 1.75rem);
    border-left: 1px solid;
    border-image: var(--h-fade-y) 1;
  }

  .hs-item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .hs-figure {
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .hs-label {
    color: var(--h-text-soft);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .hs-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hs-item:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
