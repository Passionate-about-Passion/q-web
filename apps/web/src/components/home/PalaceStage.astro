---
// Mannheim Palace, right before the speakers (DESIGN.md HOME-1), after the
// team's second 2027 mockup ("What's inside"): the palace as a line
// drawing standing flush on the stage's lower edge, held in place for one
// screen of scrolling. Two layers that never depend on each other:
//
//   outline  every line of the building and every window frame, drawn in
//            full from the first moment the palace is in view and never
//            animated (no line draws itself, nothing waits on the light)
//   light    the windows light one after the other, from the centre
//            outwards, as the visitor scrolls on through the hold (not
//            before: the palace is fully in view first); the count at the
//            top right climbs with them to the number of people, and the
//            light behind the building rises
//
// On a fine pointer, windows that are still dark light up softly around
// the pointer and fade back once it moves on (palace.client.ts, its own
// layer: the scroll's lights and progress are never touched by it).
//
// The programme on the left (keynotes, Qube pitches, workshops, campfire
// sessions, evening events) follows the scroll as in the mockup: the hold
// is split into one stretch per item, and exactly one item shows at a
// time; it changes in clear steps (the old item leaves before the new one
// comes, never on top of each other), and the bar under it marks where
// the visitor is (items passed filled, the one on screen bright). A click
// on a bar jumps to that item; scrolling, a click and the keys never fight
// over it (palace.client.ts). Every item is in the page as text. With
// reduced motion or without scroll-driven animations every item is listed
// and there are no bars.
//
// The whole building always fits: the drawing's full canvas (1600 x 420)
// scales to the space under the words, never wider than the window and
// never panned, and its ground line lies on the lower edge of what is in
// view (a phone's browser bar included). Pure CSS for everything that
// follows the scroll continuously (scroll-driven animations on the
// section's view timeline, MOTION-4); with reduced motion or without
// scroll-driven animations the palace stands fully lit, the count shows
// its total, and the section scrolls like any other (MOTION-2). The
// palace's light only rises from the building (home-theme.css,
// --h-palace-light); nothing lies below the ground line, so the speakers
// follow on the bare ground without a cut.
import "./home-theme.css";
import { drawPalace, GROUND_SHARE, PALACE_VIEW_BOX } from "./palace-drawing";

interface Props {
  /** Small line above the heading. */
  eyebrow: string;
  /** The heading's first part, e.g. "Two days". */
  heading: string;
  /** The heading's light second line, e.g. "inside a palace". */
  accent: string;
  /** How many people the count climbs to. */
  total: number;
}

const { eyebrow, heading, accent, total } = Astro.props;
const { lines, ground, windows } = drawPalace();
const fmt = new Intl.NumberFormat("en-US");
// The count climbs in steps of ten, as in the mockup.
const tens = Math.round(total / 10);
const foot = `${(GROUND_SHARE * 100).toFixed(3)}%`;

// The programme, as in the team's mockup.
const steps = [
  {
    title: "Keynotes & panels",
    text: "Founders, operators and investors on the main stage.",
  },
  { title: "Qube pitches", text: "Startups pitch live to an investor jury." },
  {
    title: "Workshops",
    text: "Hands-on sessions hosted by partner companies.",
  },
  {
    title: "Campfire sessions",
    text: "Small rounds where you ask the questions.",
  },
  {
    title: "Evening events",
    text: "The best contacts happen after the last talk.",
  },
];
---

<section
  class="h-section ps"
  id="mannheim"
  aria-labelledby="home-palace-title"
  data-palace
>
  <div class="ps-pin">
    <div class="h-shell ps-top">
      <div class="ps-head" data-h-reveal>
        <p class="h-eyebrow">{eyebrow}</p>
        <h2 class="h-title ps-title" id="home-palace-title">
          {heading}{" "}<span class="h-accent ps-accent">{accent}</span>
        </h2>
      </div>
      <p class="ps-tally" style={`--ps-end: ${tens}`}>
        <span class="ps-num" aria-hidden="true"></span>
        <span class="ps-label" aria-hidden="true">
          <span class="ps-label-run">of {fmt.format(total)} are in</span>
          <span class="ps-label-full">people, one palace</span>
        </span>
        <span class="u-visually-hidden"
          >{fmt.format(total)} people, one palace</span
        >
      </p>
      <div class="ps-program" style={`--n: ${steps.length}`}>
        <ol class="ps-steps">
          {
            steps.map((step, i) => (
              <li
                class:list={["ps-step", { "is-first": i === 0 }]}
                data-palace-step={i}
              >
                <h3 class="ps-step-title">{step.title}</h3>
                <p class="ps-step-text">{step.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="ps-bars">
          {
            steps.map((step, i) => (
              <button
                type="button"
                class="ps-bar"
                aria-label={step.title}
                data-state={i === 0 ? "current" : "next"}
                aria-current={i === 0 ? "step" : undefined}
                data-palace-bar={i}
              />
            ))
          }
        </div>
      </div>
    </div>
    <div class="ps-art" aria-hidden="true">
      <div class="ps-draw" style={`--ps-foot: ${foot}`} data-palace-art>
        <svg
          class="ps-glow"
          viewBox={PALACE_VIEW_BOX}
          preserveAspectRatio="xMidYMid meet"
          focusable="false"
        >
          <g class="ps-glow-lit">
            {windows.map((w) => <path d={w.d} style={`--t: ${w.t}`} />)}
          </g>
          <g class="ps-glow-near">{windows.map((w) => <path d={w.d} />)}</g>
        </svg>
        <svg
          class="ps-svg"
          viewBox={PALACE_VIEW_BOX}
          preserveAspectRatio="xMidYMid meet"
          focusable="false"
        >
          <linearGradient
            id="ps-ground-fade"
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="0"
            x2="1600"
            y2="0"
          >
            <stop class="ps-stop is-clear" offset="0"></stop>
            <stop class="ps-stop" offset="0.1"></stop>
            <stop class="ps-stop" offset="0.9"></stop>
            <stop class="ps-stop is-clear" offset="1"></stop>
          </linearGradient>
          <!-- The outline: always drawn in full, never animated. -->
          <g class="ps-lines">
            {lines.map((d) => <path d={d} />)}
            <path class="ps-ground" d={ground}></path>
          </g>
          <g class="ps-wins">{windows.map((w) => <path d={w.d} />)}</g>
          <!-- The light: windows lit by the scroll, then those lit around
               a pointer (palace.client.ts). -->
          <g class="ps-lit">
            {windows.map((w) => <path d={w.d} style={`--t: ${w.t}`} />)}
          </g>
          <g class="ps-near">
            {windows.map((w) => <path d={w.d} data-c={`${w.cx},${w.cy}`} />)}
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  /* DESIGN.md HOME-1 */

  /* The count: a whole number that scroll-driven animations can move. It
     counts in tens (--ps-end is the total divided by ten); the digits are
     drawn as CSS counters, with a thousands comma once it passes 999. */
  @property --ps-n {
    syntax: "<integer>";
    inherits: true;
    initial-value: 0;
  }

  @counter-style ps-three {
    system: extends decimal;
    pad: 3 "0";
  }

  .ps {
    padding-bottom: 0;
  }

  .ps-pin {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 7vw, 5rem);
  }

  /* The light behind the building (home-theme.css): it only rises from
     the palace into the night, with nothing below the ground line, so the
     stage ends on the bare ground. */
  .ps-pin::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--h-palace-light);
    -webkit-mask-image: var(--h-palace-mask);
    mask-image: var(--h-palace-mask);
    pointer-events: none;
  }

  .ps-top {
    display: grid;
    grid-template-areas:
      "head"
      "tally"
      "program";
    gap: var(--space-md);
    align-items: start;
  }

  .ps-head {
    grid-area: head;
  }

  .ps-title {
    margin-top: var(--space-sm);
  }

  .ps-accent {
    display: block;
  }

  .ps-tally {
    --ps-n: var(--ps-end);
    --ps-big: clamp(0, var(--ps-n) - 99, 1);
    --ps-full: clamp(0, var(--ps-n) - var(--ps-end) + 1, 1);

    grid-area: tally;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    margin: 0;
    counter-reset: ps-v calc(var(--ps-n) * 10) ps-k
      round(down, var(--ps-n) / 100, 1) ps-r calc(mod(var(--ps-n), 100) * 10);
  }

  /* The digits keep the room of the full number and sit at its right
     edge, so the label beside them never moves while the count climbs. */
  .ps-num {
    display: grid;
    justify-items: end;
    color: var(--color-ticket-ice);
    font-size: clamp(2.75rem, min(7.4vw, 12svh), 7.25rem);
    font-weight: var(--font-weight-extrabold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .ps-num::before,
  .ps-num::after,
  .ps-label > span {
    grid-area: 1 / 1;
  }

  .ps-num::before {
    content: counter(ps-v);
    opacity: calc(1 - var(--ps-big));
  }

  .ps-num::after {
    content: counter(ps-k) "," counter(ps-r, ps-three);
    opacity: var(--ps-big);
  }

  .ps-label {
    display: grid;
    color: var(--h-text-soft);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ps-label-run {
    opacity: calc(1 - var(--ps-full));
  }

  .ps-label-full {
    opacity: var(--ps-full);
  }

  /* The programme without the stage: every item listed side by side. */
  .ps-program {
    grid-area: program;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .ps-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-md) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ps-step-title {
    margin: 0;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .ps-step-text {
    margin: var(--space-2xs) 0 0;
    color: var(--h-text-soft);
    font-size: clamp(0.95rem, 1.3vw, 1.125rem);
    line-height: 1.5;
  }

  /* The bars mark the item on screen; they exist only on the stage. */
  .ps-bars {
    display: none;
    gap: var(--space-2xs);
  }

  /* Each bar is a 24px tall target around a 4px track. Its fill is a
     state, never a scroll position, so no bar is ever left half full:
     items passed are filled, the one on screen is filled bright, the
     ones to come are empty; a change fills or empties a bar quickly. */
  .ps-bar {
    display: grid;
    align-items: center;
    inline-size: 2.75rem;
    block-size: 1.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    cursor: pointer;
  }

  .ps-bar::before,
  .ps-bar::after {
    content: "";
    grid-area: 1 / 1;
    block-size: 4px;
    border-radius: var(--radius-pill);
  }

  .ps-bar::before {
    background: color-mix(in srgb, var(--color-white) 24%, transparent);
    transition: background-color var(--duration-hover) var(--ease-snappy);
  }

  .ps-bar::after {
    background: var(--color-ticket-ice);
    transform-origin: left center;
    scale: 0 1;
    transition:
      scale var(--duration-reveal) var(--ease-emphasized),
      opacity var(--duration-reveal) var(--ease-emphasized);
  }

  .ps-bar[data-state="done"]::after {
    scale: 1 1;
    opacity: 0.55;
  }

  .ps-bar[data-state="current"]::after {
    scale: 1 1;
    opacity: 1;
  }

  @media (hover: hover) {
    .ps-bar:hover::before {
      background: color-mix(in srgb, var(--color-white) 42%, transparent);
    }
  }

  .ps-bar:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: 2px;
  }

  @media (min-width: 48rem) {
    .ps-top {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "head tally"
        "program program";
      column-gap: var(--space-xl);
    }

    .ps-tally {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }

    .ps-label {
      justify-items: end;
    }
  }

  /* The palace stands on the stage's foot: its ground line lies on the
     lower edge (the sliver of canvas under the ground goes below it). */
  .ps-art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .ps-draw {
    position: relative;
    width: min(100%, 110rem);
    container-type: inline-size;
    translate: 0 calc(var(--ps-foot) - 1px);
  }

  .ps-draw svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 420;
    overflow: visible;
  }

  /* The windows' halo: a blurred copy, its blur in step with the
     drawing's size (10 of 1600 units). */
  .ps-glow {
    position: absolute;
    inset: 0;
    filter: blur(0.625cqw);
  }

  .ps-glow path {
    fill: var(--color-ticket-ice);
    opacity: 0.9;
  }

  /* The outline: one fine line at every size (non-scaling), in full from
     the start. Nothing here is ever animated or masked. */
  .ps-lines {
    color: color-mix(in srgb, var(--color-white) 90%, transparent);
  }

  .ps-lines path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* The ground fades out towards both ends, so no line runs to an edge. */
  .ps-lines .ps-ground {
    stroke: url(#ps-ground-fade);
  }

  .ps-stop {
    stop-color: color-mix(in srgb, var(--color-white) 90%, transparent);
  }

  .ps-stop.is-clear {
    stop-opacity: 0;
  }

  .ps-wins path {
    fill: color-mix(in srgb, var(--color-ticket-ice) 5%, transparent);
    stroke: color-mix(in srgb, var(--color-ticket-ice) 40%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .ps-lit path,
  .ps-near path {
    fill: color-mix(in srgb, var(--color-white) 82%, var(--color-ticket-ice));
    stroke: var(--color-white);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Light around a pointer (palace.client.ts sets each window's opacity):
     it comes quickly and fades back slowly. */
  .ps-near path,
  .ps-glow-near path {
    opacity: 0;
    transition: opacity calc(var(--duration-reveal) * 1.8) var(--ease-buttery);
  }

  .ps-near path.is-up,
  .ps-glow-near path.is-up {
    transition-duration: var(--duration-open);
  }

  /* Near the pointer the light is stronger than the scroll's: whiter
     panes and a wider halo (a stroke around each pane, blurred with the
     rest of the halo layer). */
  .ps-near path {
    fill: var(--color-white);
  }

  .ps-glow-near path {
    fill: var(--color-white);
    stroke: var(--color-ticket-ice);
    stroke-width: 9;
    stroke-linejoin: round;
  }

  /*
   * The stage. Progress comes from the section's view timeline:
   *   entry     the section's top climbs from the window's foot to its head
   *             (the palace, on the stage's foot, comes into view late in it)
   *   contain   the stage is held in place for one screen
   * The outline is there throughout. Each window lights over 6 % of the
   * hold at its own moment (--t, from the centre outwards), starting once
   * a sixth of the hold has passed (so the palace has been in full view
   * before the first light), while the count climbs over the same
   * stretch and the light behind the building rises. The words take the
   * space they need at the top and the palace scales to the rest (a size
   * container: never wider than the window, never taller than the space
   * left). The art keeps the part of the screen a phone's browser bar may
   * cover free (100lvh - 100svh) and the drawing moves down by as much of
   * it as the bar leaves free (100dvh - 100svh), so the ground line always
   * lies on the lower edge of what is in view and the palace keeps its
   * size when the bar comes and goes.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Longhands, never the animation shorthand: the minifier folds a
         shorthand and animation-timeline into one declaration browsers
         reject (scripts/check/build-web.mjs). */
      .ps {
        height: calc(100lvh + 100svh);
        padding-block: 0;
        view-timeline: --palace block;
        view-timeline-inset: 0;
      }

      .ps-pin {
        position: sticky;
        top: 0;
        gap: var(--space-md);
        height: 100lvh;
        padding-top: calc(
          var(--h-header-height) + clamp(var(--space-sm), 5svh, 3.5rem)
        );
        padding-bottom: calc(100lvh - 100svh);
      }

      .ps-pin::before {
        animation-name: ps-light;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --palace;
        animation-range: entry 60% contain 92%;
      }

      .ps-title {
        font-size: clamp(2.25rem, min(5.6vw, 9svh), 5.25rem);
      }

      .ps-art {
        flex: 1 1 0;
        min-height: 0;
        container-type: size;
      }

      .ps-draw {
        width: min(100cqw, 380.95cqh);
        translate: 0 calc(var(--ps-foot) - 1px + 100dvh - 100svh);
      }

      .ps-tally {
        animation-name: ps-count;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --palace;
        animation-range: contain 16% contain 88%;
      }

      .ps-lit path,
      .ps-glow-lit path {
        animation-name: ps-on;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --palace;
        animation-range: contain calc(16% + var(--t) * 66%) contain
          calc(22% + var(--t) * 66%);
      }

      /* The programme: one item at a time (palace.client.ts marks it).
         The old item leaves first, then the new one comes, so the two are
         never on screen together; transforms and opacity only
         (MOTION-3). Before the script runs, the first item shows. */
      .ps-program {
        max-width: 36rem;
      }

      .ps-steps {
        grid-template-columns: minmax(0, 1fr);
      }

      .ps-step {
        grid-area: 1 / 1;
        opacity: 0;
        translate: 0 0.5rem;
        transition:
          opacity var(--duration-close) var(--ease-snappy),
          translate var(--duration-close) var(--ease-snappy);
      }

      .ps-step[data-active],
      .ps-steps:not(:has([data-active])) .ps-step.is-first {
        opacity: 1;
        translate: 0 0;
        transition:
          opacity var(--duration-open) var(--ease-emphasized)
            var(--duration-close),
          translate var(--duration-open) var(--ease-emphasized)
            var(--duration-close);
      }

      .ps-step-title {
        font-size: clamp(1.375rem, min(3.4vw, 6svh), 3rem);
        letter-spacing: -0.03em;
        line-height: 1.05;
      }

      .ps-bars {
        display: flex;
      }
    }
  }

  /* Short landscape screens (a phone turned sideways): heading and count
     on the left, the programme on the right, so the palace keeps room. */
  @media (prefers-reduced-motion: no-preference) and (orientation: landscape) and (max-height: 34rem) {
    @supports (animation-timeline: view()) {
      .ps-top {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-areas:
          "head program"
          "tally program";
        row-gap: var(--space-2xs);
      }

      .ps-tally {
        flex-direction: row;
        align-items: baseline;
        text-align: left;
      }

      .ps-label {
        justify-items: start;
      }

      .ps-num {
        font-size: clamp(1.75rem, 10svh, 2.75rem);
      }

      .ps-step-text {
        font-size: var(--text-size-tiny);
      }
    }
  }

  @keyframes ps-count {
    from {
      --ps-n: 0;
    }

    to {
      --ps-n: var(--ps-end);
    }
  }

  @keyframes ps-on {
    from {
      opacity: 0;
    }
  }

  @keyframes ps-light {
    from {
      opacity: 0.25;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ps-step,
    .ps-bar::after,
    .ps-near path,
    .ps-glow-near path {
      transition: none;
    }
  }
</style>
