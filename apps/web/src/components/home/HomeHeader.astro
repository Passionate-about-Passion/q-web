---
// The site header and its fullscreen menu (DESIGN.md COMP-6, HOME-1),
// first built for the 2027 homepage after the concept mockup and now on
// every page (Base.astro renders it when a page brings no header of its
// own): a full-width bar of dark liquid glass with the white Q at the
// left and, at the right, the Site Settings navigation as plain links
// ("Why Q?" with a small panel of its four audience pages) and the
// Tickets button in icy liquid glass. On every page but the homepage a
// spacer of the bar's height follows it, so the page starts under the bar
// (the homepage hero runs under it on purpose).
//
// Phones (and a bar too narrow for every link, should the navigation
// grow) show the menu as three stripes instead of the links. The menu is
// a native popover (works without JavaScript; Escape closes it): the same
// items in their order, an item with children as a native disclosure,
// and beside them the edition, dates, the ticket link and the social
// profiles. home-menu.client.ts adds focus handling, the scroll lock, the
// audience panel's keys and the check that the links fit. Every ticket
// link goes to the ticket page, never to an anchor.
//
// Edition, dates, city and the offer come from the content when the page
// does not pass them (the hero badge "10 Years of Q-Summit · April 1-2,
// 2027 · Mannheim" and the ticket page's phase on sale).
import { getPageContent, getSiteSettings } from "../../lib/content";
import { TICKETS_HREF } from "../../lib/home-links";
import "./home-theme.css";

interface Props {
  /** e.g. "10 Years of Q-Summit". */
  edition?: string;
  /** e.g. "April 1-2, 2027" (as the content writes it). */
  dates?: string;
  /** e.g. "Mannheim". */
  city?: string;
  /** e.g. "30% off", from the discount phase on sale now. */
  offer?: string;
  /** Adds the spacer that keeps the page under the fixed bar. */
  spacer?: boolean;
}

const props = Astro.props;
const { nav, footer } = await getSiteSettings();

// What the page does not pass comes from the content.
let { edition, dates, city, offer } = props;
if (!edition || !dates || !city || offer === undefined) {
  const { home, ticketCategories } = await getPageContent();
  const badge = (home.hero.badge ?? "")
    .split("·")
    .map((part) => part.trim())
    .filter(Boolean);
  edition ??= badge[0] ?? "Q-Summit";
  dates ??=
    badge[1] ??
    new Intl.DateTimeFormat("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
      timeZone: "UTC",
    }).formatRange(
      new Date(home.event.startDate),
      new Date(home.event.endDate),
    );
  city ??= badge[2] ?? "Mannheim";
  const phases = ticketCategories.phases;
  const active = phases?.items.find((item) => item.key === phases.activeKey);
  offer ??=
    active && phases
      ? phases.discountLabel.replace("{discount}", String(active.discount))
      : undefined;
}

const socials = footer.socialLinks.filter((link) =>
  ["instagram-qsummit", "linkedin", "tiktok", "youtube"].includes(
    link.platform,
  ),
);
const socialName = (platform: string, label: string) =>
  platform.startsWith("instagram") ? "Instagram" : label;
// The Q alone: the site icon, drawn white through a mask.
const markStyle = "--hh-logo: url(/icon-512.png); --hh-logo-ratio: 1 / 1";

// The page the visitor is on is marked in the bar (an audience page marks
// its parent, "Why Q?").
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHere = (href: string) => {
  const path = href.replace(/[?#].*$/, "").replace(/\/+$/, "") || "/";
  return path !== "/" && (here === path || here.startsWith(`${path}/`));
};
// On the ticket page itself the header carries no ticket link (the page's
// own buy buttons do the job); the bar closes up without a gap.
const onTicketPage = isHere(TICKETS_HREF);
---

<header class="hh" id="site-header" data-home-header>
  <div class="hh-bar">
    <span class="hh-rim" aria-hidden="true"></span>
    <div class="hh-inner" data-hh-inner>
      <a class="hh-brand" href="/" aria-label="Q-Summit home">
        <span class="hh-logo" style={markStyle} aria-hidden="true"></span>
      </a>
      <nav class="hh-nav" aria-label="Main" data-hh-nav>
        <ul class="hh-links">
          {
            nav.map((item, i) =>
              item.children && item.children.length > 0 ? (
                <li
                  class:list={[
                    "hh-item has-sub",
                    {
                      "is-here": item.children.some((child) =>
                        isHere(child.href),
                      ),
                    },
                  ]}
                  data-hh-sub
                >
                  <button
                    type="button"
                    class="hh-link hh-sub-toggle"
                    aria-expanded="false"
                    aria-controls={`hh-sub-${i}`}
                    data-hh-sub-toggle
                  >
                    {item.label}
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M6 9l6 6 6-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                  <div class="hh-sub" id={`hh-sub-${i}`}>
                    <ul class="hh-sub-list">
                      {item.children.map((child) => (
                        <li>
                          <a
                            class="hh-sub-link"
                            href={child.href}
                            aria-current={
                              isHere(child.href) ? "page" : undefined
                            }
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ) : (
                <li class="hh-item">
                  <a
                    class="hh-link"
                    href={item.href}
                    aria-current={isHere(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>
      {
        !onTicketPage && (
          <a class="h-btn h-ice hh-tickets" href={TICKETS_HREF}>
            Tickets
          </a>
        )
      }
      <button
        type="button"
        class="hh-menu"
        popovertarget="home-menu"
        aria-controls="home-menu"
        aria-expanded="false"
        aria-label="Menu"
        data-home-menu-open
      >
        <svg class="hh-menu-icon" viewBox="0 0 22 16" aria-hidden="true">
          <path
            d="M1.5 1.5h19M1.5 8h19M1.5 14.5h19"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
{props.spacer && <div class="hh-spacer" aria-hidden="true" />}

<div
  class="hm h-home"
  id="home-menu"
  popover
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  data-home-menu
>
  <div class="hm-top">
    <a class="hh-brand" href="/" aria-label="Q-Summit home">
      <span class="hh-logo" style={markStyle} aria-hidden="true"></span>
    </a>
    <button
      type="button"
      class="hh-menu hm-close"
      popovertarget="home-menu"
      popovertargetaction="hide"
      aria-label="Close menu"
      data-home-menu-close
    >
      <svg class="hh-menu-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="hm-body h-shell">
    <nav class="hm-nav" aria-label="Main">
      <ol class="hm-list">
        {
          nav.map((item, i) =>
            item.children && item.children.length > 0 ? (
              <li class="hm-item" style={`--hm-i: ${i}`}>
                <details class="hm-group">
                  <summary class="hm-link">
                    <span class="hm-label">{item.label}</span>
                    <svg
                      class="hm-chevron"
                      width="28"
                      height="28"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        d="M6 9l6 6 6-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>
                  <ul class="hm-sub">
                    {item.children.map((child) => (
                      <li>
                        <a class="hm-child" href={child.href}>
                          {child.label}
                          <svg
                            class="hm-arrow"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path
                              d="M7 17L17 7M9 7h8v8"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.4"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li class="hm-item" style={`--hm-i: ${i}`}>
                <a class="hm-link" href={item.href}>
                  <span class="hm-label">{item.label}</span>
                  <svg
                    class="hm-arrow"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M7 17L17 7M9 7h8v8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            ),
          )
        }
      </ol>
    </nav>

    <aside class="hm-side" aria-label="Event">
      <div class="hm-fact">
        <p class="h-eyebrow">{edition}</p>
        <p class="hm-when">
          {dates}<br /><span class="h-accent">{city}</span>
        </p>
      </div>
      {
        !onTicketPage && (
          <a class="h-btn h-ice hm-cta" href={TICKETS_HREF}>
            Tickets{offer ? ` · ${offer}` : ""}
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M4 12h15M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )
      }
      {
        socials.length > 0 && (
          <ul class="hm-socials">
            {socials.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {socialName(link.platform, link.label)}
                  <span class="u-visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </aside>
  </div>
</div>

<script>
  import { initHomeMenu } from "./home-menu.client";

  initHomeMenu();
</script>

<style is:global>
  /* The header's height for every page: anchors land below it, and parts
     that stick under it (the ticket compare bar) read it. */
  :root {
    --site-header-height: 4.5rem;
  }

  @media (max-width: 767px) {
    :root {
      --site-header-height: 4rem;
    }
  }

  html {
    scroll-padding-top: calc(var(--site-header-height) + var(--space-xs));
  }
</style>

<style>
  /* DESIGN.md COMP-6, HOME-1. */
  .hh {
    --h-gutter: clamp(1rem, 5vw, 2.5rem);

    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--site-header-height);
    color: var(--color-white);
    pointer-events: none;
  }

  .hh-spacer {
    flex-shrink: 0;
    height: var(--site-header-height);
  }

  .hh-bar {
    position: absolute;
    inset: 0;
    pointer-events: auto;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-ticket-midnight) 90%, transparent),
      color-mix(in srgb, var(--color-ticket-midnight) 80%, transparent)
    );
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
    box-shadow: 0 12px 30px -24px var(--color-ticket-midnight);
  }

  /* The lit lower edge of the glass: brightest under the middle. */
  .hh-rim {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 6%,
      color-mix(in srgb, var(--color-ticket-ice) 10%, transparent) 26%,
      color-mix(in srgb, var(--color-ticket-ice) 22%, transparent) 50%,
      color-mix(in srgb, var(--color-ticket-ice) 10%, transparent) 74%,
      transparent 94%
    );
  }

  /* The bar's contents run across the whole window: the Q on the left
     gutter, the links and the Tickets button on the right one, the same
     gutter as the page's content (which only centers on monitors wider
     than its grid, --container-wide). */
  .hh-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(var(--space-2xs), 2.4vw, var(--space-lg));
    width: 100%;
    height: 100%;
    padding-inline: var(--h-gutter);
  }

  .hh-brand {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: auto;
    border-radius: var(--radius-ticket-button);
  }

  .hh-logo {
    display: block;
    height: clamp(1.875rem, 4vw, 2.25rem);
    aspect-ratio: var(--hh-logo-ratio);
    background: var(--color-white);
    -webkit-mask: var(--hh-logo) center / contain no-repeat;
    mask: var(--hh-logo) center / contain no-repeat;
  }

  /* ---- the links in the bar (wide screens) ----
     Plain links in a soft white, the page the visitor is on in ice. The
     sizes follow the bar's width, so all six fit beside the Tickets
     button from a small tablet up (home-menu.client.ts checks it and
     falls back to the menu should the navigation ever grow too long). */
  .hh-nav {
    display: none;
  }

  .hh-links {
    display: flex;
    align-items: center;
    gap: clamp(0rem, 0.35vw, var(--space-2xs));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hh-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .hh-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 clamp(0.4rem, 0.85vw, 0.85rem);
    border-radius: var(--radius-ticket-button);
    color: color-mix(in srgb, var(--color-white) 82%, transparent);
    font-size: clamp(0.8125rem, 0.62rem + 0.36vw, 0.9375rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-hover) var(--ease-snappy),
      background-color var(--duration-hover) var(--ease-snappy);
  }

  .hh-link[aria-current="page"],
  .is-here > .hh-sub-toggle {
    color: var(--color-ticket-ice);
  }

  /* An item with sub-items ("Why Q?") is no link of its own, as in the
     menu and the CMS: a button with a small chevron that opens its
     pages (a hover, a tap on a tablet, a click, Enter or Space). */
  .hh-sub-toggle {
    gap: 0.3rem;
    border: 0;
    background: transparent;
    font-family: inherit;
    cursor: pointer;
  }

  .hh-sub-toggle svg {
    flex: none;
    opacity: 0.75;
    transition: transform var(--duration-open) var(--ease-snappy);
  }

  .has-sub[data-open] .hh-sub-toggle svg {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .hh-link:hover {
      color: var(--color-white);
      background: color-mix(in srgb, var(--color-white) 8%, transparent);
    }
  }

  .hh-link:focus-visible,
  .hh-sub-link:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: 2px;
  }

  /* The audience pages: a small panel of the bar's dark glass under
     "Why Q?". It opens on hover (the panel's top padding bridges the gap,
     so the pointer can move into it), on keyboard focus and with the
     chevron; Escape, a click outside or leaving it closes it again. */
  .hh-sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1;
    padding-top: var(--space-2xs);
    opacity: 0;
    visibility: hidden;
    translate: 0 -0.35rem;
    transition:
      opacity var(--duration-close) var(--ease-snappy),
      translate var(--duration-close) var(--ease-snappy),
      visibility var(--duration-close);
  }

  .has-sub[data-open] .hh-sub,
  .hh:not([data-ready]) .has-sub:is(:hover, :focus-within) .hh-sub {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition:
      opacity var(--duration-open) var(--ease-emphasized),
      translate var(--duration-open) var(--ease-emphasized),
      visibility var(--duration-open);
  }

  .hh-sub-list {
    display: grid;
    min-width: 15rem;
    margin: 0;
    padding: var(--space-2xs);
    border-radius: var(--radius-ticket-panel);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-ticket-deep) 92%, transparent),
      color-mix(in srgb, var(--color-ticket-midnight) 94%, transparent)
    );
    box-shadow:
      inset 0 0 0 1px
        color-mix(in srgb, var(--color-ticket-ice) 18%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 26%, transparent),
      0 22px 40px -22px var(--color-ticket-midnight);
    list-style: none;
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
  }

  .hh-sub-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-sm);
    border-radius: var(--radius-ticket-button);
    color: color-mix(in srgb, var(--color-white) 86%, transparent);
    font-size: var(--text-size-small);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-hover) var(--ease-snappy),
      background-color var(--duration-hover) var(--ease-snappy);
  }

  .hh-sub-link[aria-current="page"] {
    color: var(--color-ticket-ice);
  }

  @media (hover: hover) {
    .hh-sub-link:hover {
      color: var(--color-white);
      background: color-mix(in srgb, var(--color-white) 8%, transparent);
    }
  }

  /* Only the stripes: a square as tall as the Tickets button, the
     stripes filling most of it, so both read as one pair. Phones only. */
  .hh-menu {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-ticket-button);
    background: transparent;
    color: var(--color-white);
    font: inherit;
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--duration-hover) var(--ease-snappy);
  }

  @media (hover: hover) {
    .hh-menu:hover {
      background: color-mix(in srgb, var(--color-white) 8%, transparent);
    }
  }

  .hh-menu-icon {
    width: 2rem;
    height: 1.5rem;
  }

  .hh-menu:focus-visible,
  .hh-brand:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: 2px;
  }

  .hh-tickets.h-btn {
    min-height: 2.75rem;
    padding: 0 1.25rem;
    font-size: var(--text-size-tiny);
  }

  @media (max-width: 359px) {
    .hh-tickets.h-btn {
      padding: 0 0.85rem;
    }
  }

  /* Wide screens: the links in the bar, no menu. Should the links not
     fit (home-menu.client.ts sets data-collapsed), the menu comes back and
     the links wait unseen, so they can still be measured. */
  @media (min-width: 48rem) {
    .hh-nav {
      display: block;
      flex: none;
    }

    .hh-menu {
      display: none;
    }

    .hh[data-collapsed] .hh-nav {
      position: absolute;
      visibility: hidden;
      pointer-events: none;
    }

    .hh[data-collapsed] .hh-menu {
      display: inline-grid;
    }
  }

  /* ---- the fullscreen menu ---- */
  .hm {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--color-white);
    background:
      radial-gradient(
        60% 50% at 85% 10%,
        color-mix(in srgb, var(--color-ticket-deep) 90%, transparent),
        transparent 70%
      ),
      radial-gradient(
        50% 40% at 0% 100%,
        color-mix(in srgb, var(--color-ticket-sky) 22%, transparent),
        transparent 70%
      ),
      var(--color-ticket-midnight);
  }

  .hm:popover-open {
    display: flex;
    flex-direction: column;
  }

  /* The sheet's top row mirrors the bar: the Q and the close button on
     the same gutters. */
  .hm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: var(--h-header-height, 4.5rem);
    padding-inline: var(--h-gutter);
    border-bottom: 1px solid;
    border-image: var(--h-fade-x) 1;
  }

  .hm-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
    gap: clamp(var(--space-lg), 6vw, 4.5rem);
    flex: 1;
    align-items: center;
    padding-block: clamp(var(--space-lg), 5vh, 3.5rem);
  }

  .hm-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid;
    border-image: var(--h-fade-x) 1;
  }

  .hm-item {
    border-top: 1px solid;
    border-image: var(--h-fade-x) 1;
  }

  .hm-link {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-sm), 2.5vw, 1.75rem);
    padding-block: clamp(0.6rem, 1.6vh, 1.1rem);
    color: var(--color-white);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    transition:
      color var(--duration-hover) var(--ease-snappy),
      transform var(--duration-hover) var(--ease-snappy);
  }

  .hm-link::-webkit-details-marker {
    display: none;
  }

  .hm-label {
    flex: 1;
    font-size: clamp(2rem, 5.2vw, 4rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  /* An SVG arrow in the label's color (a text arrow turns into a colored
     emoji on iPhones). */
  .hm-arrow {
    flex: none;
    width: clamp(1.25rem, 2.4vw, 2rem);
    height: clamp(1.25rem, 2.4vw, 2rem);
    opacity: 0.35;
    transition:
      opacity var(--duration-hover) var(--ease-snappy),
