---
// The discount phases (DESIGN.md HOME-1), after the team's "Early Bird is
// live" post: the sale's opener (ui/SaleIntro.astro: "Early Bird is
// live." beside the offer, with its countdown, or, between two phases,
// "Christmas Sale is coming."), then the four phases as four cards of
// liquid glass (ui/SaleCards.astro, the same cards and opener as the
// ticket page): the current phase in baby blue glass, the whole card a
// link to the tickets; the coming phases as clear grey glass, plain
// text; phases already over fade further. No line joins them.
//
// Phases, discounts, the current phase, whether it is on sale and the
// status words come from the ticket page's content (one source,
// page-tickets, phases); nothing switches by date. The button opens the
// ticket page.
import type { TicketPhases } from "../../lib/content";
import { TICKETS_HREF } from "../../lib/home-links";
import { saleActionLabel } from "../../lib/sale";
import SaleCards from "../ui/SaleCards.astro";
import SaleIntro from "../ui/SaleIntro.astro";
import "./home-theme.css";

interface Props {
  phases: TicketPhases;
}

const { phases } = Astro.props;
---

{
  phases.items.length > 0 && (
    <section
      class="h-section sp"
      id="phases"
      aria-labelledby="home-phases-title"
    >
      <div class="h-shell">
        <SaleIntro
          phases={phases}
          href={TICKETS_HREF}
          headingId="home-phases-title"
          reveal
        />

        <div class="sp-cards" data-h-reveal>
          <SaleCards
            phases={phases}
            href={TICKETS_HREF}
            actionLabel={saleActionLabel(phases)}
          />
        </div>
      </div>
    </section>
  )
}
