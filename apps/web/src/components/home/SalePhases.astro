---
// The discount phases (DESIGN.md HOME-1), after the team's "Early Bird is
// live" post: the heading "… is live." beside the offer, told as one
// sentence ("30% off every ticket until 22 November. The earlier you book,
// the less you pay."), then the countdown with what comes after it ("then
// 25% off"), so it is plain the price rises, and the ticket link; then
// the four phases as four cards of liquid glass (ui/SaleCards.astro, the
// same cards open the ticket page): the phase on sale in baby blue glass,
// the whole card a link to the tickets; the coming phases as clear grey
// glass, plain text; phases already over fade further. No line joins
// them.
//
// Phases, discounts, the phase on sale now and the status words come
// from the ticket page's content (one source, page-ticket-categories,
// phases); nothing switches by date. When the phase on sale has an end
// (its optional "Ends at"), the offer names the day and a countdown runs
// to it (home.client.ts; it ticks only while in view and goes away at the
// end). The button opens the ticket page.
import type { TicketPhases } from "../../lib/content";
import { TICKETS_HREF } from "../../lib/home-links";
import SaleCards from "../ui/SaleCards.astro";
import "./home-theme.css";

interface Props {
  phases: TicketPhases;
}

const { phases } = Astro.props;
const activeIndex = Math.max(
  0,
  phases.items.findIndex((item) => item.key === phases.activeKey),
);
const active = phases.items[activeIndex];
const offer = active
  ? phases.discountLabel.replace("{discount}", String(active.discount))
  : "";
// The end of the phase on sale, if the content gives one, in German time.
const endsAt =
  active?.endsAt && !Number.isNaN(Date.parse(active.endsAt))
    ? active.endsAt
    : undefined;
const endDay = endsAt
  ? new Intl.DateTimeFormat("en-GB", {
      day: "numeric",
      month: "long",
      timeZone: "Europe/Berlin",
    }).format(new Date(endsAt))
  : undefined;
// The phase after this one, if any: what the price becomes.
const next = phases.items[activeIndex + 1];
const nextOffer = next
  ? phases.discountLabel.replace("{discount}", String(next.discount))
  : undefined;
---

{
  active && (
    <section
      class="h-section sp"
      id="phases"
      aria-labelledby="home-phases-title"
    >
      <div class="h-shell">
        <div class="sp-head">
          <div class="sp-title-box">
            <h2 class="h-title sp-title" id="home-phases-title" data-h-reveal>
              <span class="h-accent">{active.label}</span>
              <br />
              is live.
            </h2>
          </div>
          <div class="sp-aside" data-h-reveal>
            <div class="sp-copy">
              <p class="sp-offer">
                <strong>{offer}</strong> every ticket
                {endDay ? ` until ${endDay}.` : "."}
              </p>
              <p class="sp-why">The earlier you book, the less you pay.</p>
            </div>
            {endsAt && (
              <p class="sp-clock" data-sp-clock={endsAt} hidden>
                <span class="sp-clock-label">{active.label} ends in</span>
                <span class="sp-clock-time" aria-hidden="true" data-sp-time />
                {nextOffer && (
                  <span class="sp-clock-next">then only {nextOffer}</span>
                )}
              </p>
            )}
            <a class="h-btn h-ice sp-cta" href={TICKETS_HREF}>
              Get your {active.label} ticket
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M4 12h15M13 6l6 6-6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        </div>

        <div class="sp-cards" data-h-reveal>
          <SaleCards
            phases={phases}
            href={TICKETS_HREF}
            actionLabel={`Get your ${active.label} ticket`}
          />
        </div>
      </div>
    </section>
  )
}

<style>
  /* DESIGN.md HOME-1 */
  .sp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: clamp(var(--space-xl), 6vw, 5rem);
  }

  .sp-title {
    font-size: clamp(2.75rem, 7vw, 6.75rem);
  }

  /* Wide screens: the heading is exactly as tall as the offer beside it
     (its two lines fill the row the offer sets; the box is size-contained,
     so only the offer decides the height), top and foot level, never
     wider than its column. */
  @media (min-width: 48rem) {
    .sp-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: stretch;
    }

    .sp-title-box {
      container-type: size;
      min-height: 0;
    }

    .sp-title {
      font-size: min(calc(100cqh / 1.88), calc(100cqw / 5.4));
      line-height: 0.94;
    }
  }

  .sp-aside {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    min-width: 0;
    max-width: 26rem;
  }

  /* On the narrowest phones the ticket link may wrap to two lines rather
     than run past the screen's edge. */
  .sp-cta {
    max-width: 100%;
    padding-block: var(--space-2xs);
    white-space: normal;
    text-align: center;
  }

  /* The offer as a sentence: the discount in ice and heavy, the rest
     white; the reason under it, softer. */
  .sp-copy {
    display: grid;
    gap: var(--space-xs);
  }

  .sp-offer {
    margin: 0;
    color: var(--color-white);
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .sp-offer strong {
    color: var(--color-ticket-ice);
    font-weight: var(--font-weight-extrabold);
  }

  .sp-why {
    margin: 0;
    color: var(--h-text-soft);
    font-size: var(--text-size-medium);
    line-height: 1.45;
  }

  /* The countdown: what is left of the phase, large, and what the price
     becomes after it, so the rise is plain. A fine rule above sets it
     apart from the sentence. */
  .sp-clock {
    display: grid;
    gap: 0.2rem;
    width: 100%;
    margin: 0;
    padding-top: var(--space-sm);
    border-top: 1px solid
      color-mix(in srgb, var(--color-white) 16%, transparent);
  }

  .sp-clock-label,
  .sp-clock-next {
    color: var(--h-text-soft);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sp-clock-time {
    color: var(--color-white);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: var(--font-weight-extrabold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1.15;
    white-space: nowrap;
  }

  .sp-clock[hidden] {
    display: none;
  }
</style>
