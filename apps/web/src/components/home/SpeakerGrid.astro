---
// Speakers (DESIGN.md HOME-1, after the 2027 concept mockup): "Voices on
// stage" as one horizontal rail of portrait cards, never a fixed grid.
// It is dragged or swiped, scrolled with a trackpad or the keyboard and
// stepped with the two arrows (speaker-carousel.client.ts); it never moves
// by itself. The cards beyond the page width, at the window's edges, turn
// away a little and dim, so the rail reads as going on; the faces and
// names inside the page width are never shaded.
//
// A card: the portrait fills it, a navy shade at its foot carries the
// name and the role (and a tag for a booked speaker), so nothing ever
// lies over a face:
//
//   lineup   the next edition's published speakers, tagged with the
//            edition's year (filled ice tag); shown first
//   alumni   past speakers: name and role only, no tag on the picture
//            (the team asked for the pictures without "Previous Speaker";
//            the heading says these are highlights). The prop names are
//            historical: they are not Q alumni (former team members)
//
// While the next edition has no published speaker, index.astro may pass
// earlier speakers in their place; like the past speakers they carry no
// tag. Open slots render only as marked placeholders in a local preview,
// never a name or face.
import { Picture } from "../../lib/astro-assets";
import type { PageLink, Speaker } from "../../lib/content";
import { photoSrc } from "../../lib/media-filename";
import { resolveContentImage } from "../../lib/images";
import "./home-theme.css";

interface Props {
  eyebrow?: string;
  heading: string;
  cta: PageLink | undefined;
  /** Past speakers, in display order. */
  alumni: Speaker[];
  alumniLabel?: string;
  /** Published speakers of the next edition (or stand-ins, see lineupLabel). */
  lineup?: Speaker[];
  lineupLabel?: string;
  /** True when `lineup` holds booked speakers of the next edition. */
  lineupBooked?: boolean;
  lineupSlots?: number;
  placeholders?: boolean;
  placeholderName?: string;
  placeholderRole?: string;
}

const {
  eyebrow,
  heading,
  cta,
  alumni,
  alumniLabel,
  lineup = [],
  lineupLabel,
  lineupBooked = false,
  lineupSlots = 0,
  placeholders = false,
  placeholderName = "",
  placeholderRole = "",
} = Astro.props;

type Card =
  | { kind: "speaker"; speaker: Speaker; badge?: string; booked: boolean }
  | { kind: "placeholder"; badge?: string };

const lineupCards: Card[] = lineup
  .slice(0, lineupSlots || lineup.length)
  .map((speaker) => ({
    kind: "speaker",
    speaker,
    badge: lineupLabel,
    booked: lineupBooked,
  }));
if (placeholders) {
  while (lineupCards.length < lineupSlots) {
    lineupCards.push({ kind: "placeholder", badge: lineupLabel });
  }
}

// Booked speakers lead; earlier speakers follow.
const cards: Card[] = lineupBooked
  ? [
      ...lineupCards,
      ...alumni.map((speaker): Card => ({
        kind: "speaker",
        speaker,
        badge: alumniLabel,
        booked: false,
      })),
    ]
  : [
      ...alumni.map((speaker): Card => ({
        kind: "speaker",
        speaker,
        badge: alumniLabel,
        booked: false,
      })),
      ...lineupCards,
    ];

// The loop: the cards five times over; the middle copy is the real one,
// the others only give the ring room to run (fast swipes never reach an
// end) and are skipped by assistive tech and the keyboard (aria-hidden,
// inert).
const COPIES = [0, 1, 2, 3, 4] as const;
const MIDDLE = 2;

// "Voices on stage": the last words in ice.
const words = heading.trim().split(/\s+/);
const accentCount = words.length > 2 ? 2 : words.length > 1 ? 1 : 0;
const headLead = words.slice(0, words.length - accentCount).join(" ");
const headAccent = words.slice(words.length - accentCount).join(" ");

const images = await Promise.all(
  cards.map((card) =>
    card.kind === "speaker"
      ? resolveContentImage(
          card.speaker.photoFilename,
          `home speaker ${card.speaker.name}`,
        )
      : null,
  ),
);
---

{
  cards.length > 0 && (
    <section
      class="h-section sr"
      id="speakers"
      aria-labelledby="home-speakers-title"
    >
      <div class="h-shell sr-head">
        <div>
          {eyebrow && (
            <p class="h-eyebrow" data-lp="previousSpeakers.eyebrow">
              {eyebrow}
            </p>
          )}
          <h2
            id="home-speakers-title"
            class="h-title sr-title"
            data-lp="previousSpeakers.heading"
            data-h-reveal
          >
            {headLead}
            {headLead && <br />}
            <span class="h-accent">{headAccent}</span>
          </h2>
        </div>
        <div class="sr-tools" data-h-reveal>
          {cta && (
            <a
              class="h-btn h-frost"
              href={cta.href}
              data-lp="previousSpeakers.cta"
              data-lp-href="previousSpeakers.cta.href"
            >
              <span data-lp-label>{cta.label}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M4 12h15M13 6l6 6-6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          )}
        </div>
      </div>

      <div
        class="sr-carousel"
        data-speaker-carousel
        data-copies={COPIES.length}
        data-h-reveal
      >
        <div
          class="sr-viewport"
          role="region"
          aria-roledescription="carousel"
          aria-label={heading}
          tabindex="0"
          data-speaker-viewport
        >
          <ul class="sr-track" data-speaker-track>
            {COPIES.map((copy) =>
              cards.map((card, i) => (
                <li
                  class="sr-slot"
                  aria-hidden={copy !== MIDDLE ? "true" : undefined}
                  inert={copy !== MIDDLE}
                  data-speaker-card
                  data-copy={copy}
                >
                  <article
                    class:list={[
                      "sr-card",
                      card.kind === "placeholder" && "is-placeholder",
                    ]}
                    data-speaker-face
                  >
                    <div class="sr-photo">
                      {card.kind === "placeholder" ? (
                        <span class="sr-blank" aria-hidden="true" />
                      ) : images[i] ? (
                        <Picture
                          src={images[i]!}
                          alt={`Portrait of ${card.speaker.name}`}
                          widths={[320, 480, 640]}
                          sizes="(max-width: 599px) 46vw, (max-width: 1023px) 31vw, 19rem"
                          formats={["avif", "webp"]}
                          fallbackFormat="jpg"
                          quality={80}
                          loading="lazy"
                          draggable="false"
                        />
                      ) : (
                        <img
                          src={photoSrc(card.speaker.photoFilename)}
                          alt={`Portrait of ${card.speaker.name}`}
                          width="640"
                          height="800"
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                        />
                      )}
                    </div>
                    <span class="sr-shade" aria-hidden="true" />
                    <div class="sr-caption">
                      {card.badge &&
                        (card.kind === "placeholder" || card.booked) && (
                          <p class="sr-tag is-booked">{card.badge}</p>
                        )}
                      <h3>
                        {card.kind === "speaker"
                          ? card.speaker.name
                          : placeholderName}
                      </h3>
                      <p class="sr-role">
                        {card.kind === "speaker"
                          ? card.speaker.roleLine
                          : placeholderRole}
                      </p>
                    </div>
                  </article>
                </li>
              )),
            )}
          </ul>
        </div>
        <button
          type="button"
          class="h-glass-btn sr-arrow is-prev"
          aria-label="Previous speakers"
          data-speaker-prev
          data-glass-press
        >
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M15 5l-7 7 7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <button
          type="button"
          class="h-glass-btn sr-arrow is-next"
          aria-label="Next speakers"
          data-speaker-next
          data-glass-press
        >
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M9 5l7 7-7 7"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </section>
  )
}

<script>
  import "./speaker-carousel.client";
</script>

<style>
  /* DESIGN.md HOME-1 */
  .sr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  /* Two lines of heavy type: the descender of the first ("p" in
     "Speaker") must clear the ascenders of the second ("h", "l", "g"),
     which a line height under 1 lets them touch. */
  .sr-title {
    margin-top: var(--space-xs);
    font-size: clamp(2.75rem, 7vw, 6.75rem);
    line-height: 1.06;
  }

  .sr-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  /* The arrows sit on the rail, each in the gap where the clear cards
     meet the ones turning away at the window's edge, in the page's round
     clear glass (home-theme.css .h-glass-btn, no glow). They show once
     the rail is ready (speaker-carousel.client.ts), on phones too (a
     little smaller there), next to swiping. */
  .sr-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 3.25rem;
    translate: -50% -50%;
  }

  .sr-arrow.is-prev {
    left: calc(var(--peek) - var(--gap) / 2);
  }

  .sr-arrow.is-next {
    left: calc(100cqw - var(--peek) + var(--gap) / 2);
  }

  .sr-carousel:not([data-ready]) .sr-arrow {
    visibility: hidden;
  }

  /*
   * The rail runs from one edge of the window to the other; inside the
   * page width (--peek in from each edge) the cards stand clear, beyond it
   * they turn away and dim (speaker-carousel.client.ts). A card is as wide
   * as --per cards and their gaps fill the page width exactly.
   */
  .sr-carousel {
    --peek: max(clamp(1rem, 5vw, 2.5rem), (100cqw - var(--container-wide)) / 2);
    --per: 4;
    --gap: var(--space-sm);
    --card-w: calc(
      (100cqw - 2 * var(--peek) - (var(--per) - 1) * var(--gap)) / var(--per)
    );

    position: relative;
    margin-top: clamp(var(--space-lg), 4vw, var(--space-xl));
    container-type: inline-size;
  }

  .sr-viewport {
    overflow: auto hidden;
    padding-block: var(--space-2xs);
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--peek);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
  }

  .sr-viewport::-webkit-scrollbar {
    display: none;
  }

  .sr-viewport:focus-visible {
    outline: 2px solid var(--color-ticket-ice);
    outline-offset: -2px;
  }

  .sr-viewport:global(.is-dragging) {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  /* While the ring runs by itself, the script settles it on a card
     (CSS snapping would pull the slow run back every frame). */
  .sr-viewport:global(.is-free) {
    scroll-snap-type: none;
  }

  .sr-track {
    display: flex;
    gap: var(--gap);
    width: max-content;
    margin: 0;
    padding: 0 var(--peek);
    list-style: none;
  }

  .sr-slot {
    display: flex;
    flex: 0 0 var(--card-w);
    scroll-snap-align: start;
  }

  .sr-card {
    position: relative;
    isolation: isolate;
    flex: 1 1 auto;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-ticket-card);
    background: var(--color-home-ground);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--color-white) 12%, transparent);
    user-select: none;
  }

  .sr-photo,
  .sr-photo :global(picture),
  .sr-photo :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .sr-photo {
    z-index: -1;
  }

  .sr-photo :global(img) {
    object-fit: cover;
    object-position: 50% 22%;
    transition: transform calc(var(--duration-reveal) * 1.2)
      var(--ease-emphasized);
  }

  .sr-blank {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 40% 30%,
      var(--color-ticket-sky),
      var(--color-navy) 60%
    );
  }

  /* The navy shade at the foot carries the name; the face stays clear. */
  .sr-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 42%,
      color-mix(in srgb, var(--color-ticket-midnight) 55%, transparent) 64%,
      color-mix(in srgb, var(--color-ticket-midnight) 94%, transparent) 100%
    );
  }

  /* Only booked speakers of the next edition carry a tag (filled ice). */
  .sr-tag {
    justify-self: start;
    max-width: 100%;
    margin: 0 0 0.2rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-ticket-pill);
    background: var(--color-ticket-ice);
    color: var(--color-ticket-midnight);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sr-caption {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }

  .sr-caption h3 {
    margin: 0;
    font-size: clamp(1.125rem, 1.6vw, 1.4rem);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.015em;
    line-height: 1.12;
  }

  .sr-role {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--h-text-soft);
    font-size: var(--text-size-small);
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (hover: hover) {
    .sr-card:hover .sr-photo :global(img) {
      transform: scale(1.03);
    }
  }

  @media (max-width: 1023px) {
    .sr-carousel {
      --per: 3;
    }
  }

  @media (max-width: 599px) {
    .sr-carousel {
      --per: 2;
      --gap: var(--space-xs);
      --peek: max(clamp(1rem, 5vw, 2.5rem), 9cqw);
    }

    .sr-arrow {
      width: 2.75rem;
    }

    /* Taller cards and a compact caption: the face keeps the upper two
       thirds to itself. */
    .sr-card {
      aspect-ratio: 5 / 7.4;
    }

    .sr-caption {
      right: 0.7rem;
      bottom: 0.75rem;
      left: 0.7rem;
      gap: 0.2rem;
    }

    .sr-tag {
      padding: 0.22rem 0.45rem;
      font-size: min(var(--text-size-tiny), 2.3vw);
      letter-spacing: 0.02em;
      line-height: 1.15;
      /* Mobile browsers enlarge small text on their own (font boosting),
         which wrapped the tag; zoom and the system text size still apply. */
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }

    .sr-caption h3 {
      font-size: var(--text-size-regular);
    }

    .sr-role {
      font-size: var(--text-size-tiny);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sr-photo :global(img) {
      transition: none;
    }
  }
</style>
