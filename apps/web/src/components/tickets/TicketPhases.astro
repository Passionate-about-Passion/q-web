---
// The discount phases above the ticket hero heading (DESIGN.md TICKETS-1,
// MOTION-6): Early Bird, Christmas, Back 2 Uni, Late Bird, as the shop
// runs them one after another. One source (ticketCategories.phases) for
// the phases and the one on sale now; the state is never derived from a
// date, because the shop moves on when a phase sells out.
//
// Looks exactly like the homepage's discount phases (home/SalePhases.astro,
// its .sp-board): one pane of translucent liquid glass, the four phases on
// one fine line that is drawn bright up to the phase on sale now, small
// hollow points for the others, the phase on sale marked with a milky
// white Q on a round disc of blue light, its discount large in ice and a
// filled ice tag; coming phases quieter with an outlined tag, past phases
// fade further. On first paint the pane unfolds, the line draws and the
// phases settle in left to right, once; the Q sits on the active phase
// from its first frame, so nothing suggests the sale moving.
import type { TicketPhases } from "../../lib/content";
import { fillLabel, phaseStates } from "./ticket-model";

interface Props {
  phases: TicketPhases;
}

const { phases } = Astro.props;
const items = phaseStates(phases);
const activeIndex = Math.max(
  0,
  items.findIndex((p) => p.state === "current"),
);
const progress = items.length > 1 ? activeIndex / (items.length - 1) : 0;
const markSrc = "/icon-512.png";
const stateLabel = {
  past: phases.pastLabel,
  current: phases.currentLabel,
  upcoming: phases.upcomingLabel,
} as const;
---

<div
  class="t-phases"
  style={`--n: ${items.length}; --progress: ${progress}`}
  data-ticket-phases
>
  <span class="t-phases-glass" aria-hidden="true"></span>
  <div class="t-phases-track">
    <span class="t-phases-line" aria-hidden="true">
      <span class="t-phases-fill"></span>
    </span>
    <ol class="t-phases-list" aria-label={phases.label}>
      {
        items.map((p, i) => (
          <li
            class="t-phase"
            data-state={p.state}
            style={`--i: ${i}`}
            aria-current={p.state === "current" ? "step" : undefined}
          >
            <span class="t-phase-node" aria-hidden="true">
              {p.state === "current" && (
                <span class="t-phase-tile">
                  <span class="t-phase-lift">
                    <span class="t-phase-q" style={`--mark: url(${markSrc})`} />
                  </span>
                </span>
              )}
            </span>
            <span class="t-phase-name">{p.label}</span>
            <span class="t-phase-off">
              {fillLabel(phases.discountLabel, {
                discount: String(p.discount),
              })}
            </span>
            <span class="t-phase-state">{stateLabel[p.state]}</span>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  /*
   * DESIGN.md TICKETS-1: every value mirrors home/SalePhases.astro (.sp-*),
   * so both pages show the same board. The pane's glass is its own layer
   * (.t-phases-glass), so the board itself is no backdrop root (COMP-6
   * note in DESIGN.md) and the unfold can run on that layer alone.
   */
  .t-phases {
    --node: 3rem;

    position: relative;
    isolation: isolate;
    width: 100%;
    margin-bottom: var(--space-md);
    padding: clamp(var(--space-md), 4vw, var(--space-xl))
      clamp(var(--space-sm), 3vw, 2.5rem);
    border-radius: var(--radius-ticket-card);
    color: var(--color-white);
  }

  /* Translucent liquid glass: barely any fill, a lit rim brighter at the
     top, a faint cyan line inside the lower edge, the page light showing
     through. No backdrop blur: behind it lies only that light. */
  .t-phases-glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--color-ticket-sky) 20%, transparent),
      color-mix(in srgb, var(--color-ticket-deep) 28%, transparent) 55%,
      color-mix(in srgb, var(--color-ticket-midnight) 30%, transparent)
    );
    box-shadow:
      inset 0 0 0 1px
        color-mix(in srgb, var(--color-ticket-ice) 22%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 40%, transparent),
      inset 0 -14px 22px -18px
        color-mix(in srgb, var(--color-ticket-cyan) 70%, transparent),
      0 24px 50px -30px var(--color-ticket-midnight);
  }

  .t-phases-track {
    position: relative;
  }

  .t-phases-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The line through the node centres, bright up to the phase on sale. */
  .t-phases-line {
    position: absolute;
    top: calc(var(--node) / 2 - 1px);
    left: calc(50% / var(--n));
    right: calc(50% / var(--n));
    height: 2px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-ticket-ice) 45%, transparent);
    box-shadow: 0 0 8px
      color-mix(in srgb, var(--color-ticket-cyan) 25%, transparent);
    transform-origin: left;
  }

  .t-phases-fill {
    position: absolute;
    inset: 0;
    background: var(--color-ticket-ice);
    box-shadow: 0 0 10px
      color-mix(in srgb, var(--color-ticket-cyan) 70%, transparent);
    transform: scaleX(var(--progress));
    transform-origin: left;
  }

  .t-phase {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    min-width: 0;
    text-align: center;
  }

  .t-phase-node {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    margin-bottom: var(--space-sm);
  }

  /* Every other phase: a small hollow point on the line. */
  .t-phase-node::before {
    content: "";
    width: 0.8rem;
    height: 0.8rem;
    border-radius: var(--radius-circle);
    background: var(--color-home-ground);
    box-shadow: inset 0 0 0 1.5px
      color-mix(in srgb, var(--color-ticket-ice) 60%, transparent);
  }

  .t-phase[data-state="past"] .t-phase-node::before {
    background: color-mix(
      in srgb,
      var(--color-ticket-ice) 40%,
      var(--color-home-ground)
    );
    box-shadow: none;
  }

  /* The phase on sale: the original Q mark (public/icon-512.png as a
     mask, never redrawn), milky white and gently raised, on a round disc
     of deep blue light (a glow at its middle, a hairline rim, a lit top
     edge and a soft drop shadow). */
  .t-phase[data-state="current"] .t-phase-node::before {
    display: none;
  }

  .t-phase-tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 130%;
    aspect-ratio: 1;
    border-radius: var(--radius-circle);
    background:
      radial-gradient(
        70% 70% at 50% 46%,
        color-mix(in srgb, var(--color-ticket-sky) 90%, transparent),
        transparent 75%
      ),
      linear-gradient(
        150deg,
        var(--color-ticket-deep),
        var(--color-navy) 55%,
        var(--color-ticket-midnight)
      );
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-white) 30%, transparent),
      inset 0 1px 1px color-mix(in srgb, var(--color-white) 60%, transparent),
      0 12px 20px -14px color-mix(in srgb, var(--color-navy) 70%, transparent),
      0 0 18px -8px
        color-mix(in srgb, var(--color-ticket-cyan) 60%, transparent);
  }

  /* The shadow sits on a wrapper: the mask would cut a shadow on the Q. */
  .t-phase-lift {
    display: grid;
    width: 56%;
    filter: drop-shadow(
        0 1.5px 1px
          color-mix(in srgb, var(--color-ticket-midnight) 65%, transparent)
      )
      drop-shadow(
        0 0 3px color-mix(in srgb, var(--color-white) 30%, transparent)
      );
  }

  .t-phase-q {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(
      170deg,
      var(--color-white) 0%,
      color-mix(in srgb, var(--color-white) 88%, var(--color-ticket-ice)) 55%,
      color-mix(in srgb, var(--color-ticket-ice) 70%, var(--color-white)) 100%
    );
    opacity: 0.94;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
  }

  .t-phase-name {
    color: color-mix(in srgb, var(--color-white) 78%, transparent);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .t-phase-off {
    color: color-mix(in srgb, var(--color-white) 70%, transparent);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-extrabold);
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .t-phase-state {
    padding: 0.35rem var(--space-xs);
    border-radius: var(--radius-ticket-pill);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--color-white) 30%, transparent);
    color: color-mix(in srgb, var(--color-white) 78%, transparent);
    font-size: var(--text-size-tiny);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .t-phase[data-state="current"] .t-phase-name {
    color: var(--color-white);
  }

  .t-phase[data-state="current"] .t-phase-off {
    color: var(--color-ticket-ice);
  }

  .t-phase[data-state="current"] .t-phase-state {
    background: var(--color-ticket-ice);
    box-shadow: none;
    color: var(--color-ticket-midnight);
  }

  .t-phase[data-state="past"] .t-phase-name,
  .t-phase[data-state="past"] .t-phase-off,
  .t-phase[data-state="past"] .t-phase-state {
    opacity: 0.45;
  }

  /* Tablets: four phases still in one row, the discount a step smaller so
     "25% off" never runs into its neighbor. */
  @media (max-width: 899px) {
    .t-phase-off {
      font-size: clamp(1.5rem, 4.6vw, 2rem);
    }
  }

  /* Phones: the phases as a list down one line, as on the homepage, kept
     compact (the discount beside the name, the tag at the right) so the
     heading still reaches the first screen. */
  @media (max-width: 679px) {
    .t-phases {
      --node: 2.5rem;

      padding: var(--space-sm) var(--space-sm);
    }

    .t-phases-list {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xs);
    }

    .t-phases-line {
      top: calc(var(--node) / 2);
      bottom: calc(var(--node) / 2);
      left: calc(var(--node) / 2 - 1px);
      right: auto;
      width: 2px;
      height: auto;
      transform-origin: top;
    }

    .t-phases-fill {
      transform: scaleY(var(--progress));
      transform-origin: top;
    }

    .t-phase {
      grid-template-columns: var(--node) minmax(0, 1fr) auto;
      grid-template-areas:
        "node name state"
        "node off state";
      justify-items: start;
      align-items: center;
      column-gap: var(--space-sm);
      row-gap: 0.1rem;
      text-align: left;
    }

    .t-phase-node {
      grid-area: node;
      margin: 0;
    }

    .t-phase-name {
      grid-area: name;
      align-self: end;
    }

    .t-phase-off {
      grid-area: off;
      align-self: start;
      font-size: clamp(1.375rem, 7vw, 1.75rem);
    }

    .t-phase-state {
      grid-area: state;
    }
  }

  /* The narrowest phones (320px): each name stays on one line, clear of
     its tag. */
  @media (max-width: 379px) {
    .t-phases {
      --node: 2.25rem;

      padding-inline: var(--space-xs);
    }

    .t-phase {
      column-gap: var(--space-xs);
    }

    .t-phase-name {
      letter-spacing: 0.06em;
      white-space: nowrap;
    }

    .t-phase-state {
      padding: 0.3rem 0.55rem;
      letter-spacing: 0.02em;
    }
  }

  /*
   * First appearance, once (CSS on load, no script, never on scroll): the
   * pane unfolds, the line draws from the first phase, then the phases
   * settle in left to right, a few frames apart. The Q is on the active
   * phase from its first frame and only blooms in with it. Backwards fill
   * only: once played, nothing keeps an animation (or a compositor layer)
   * alive.
   */
  @media (prefers-reduced-motion: no-preference) {
    /* The unfold runs on the glass layer, never on .t-phases: opacity or
       a transform there would make the board a backdrop root. */
    .t-phases-glass {
      transform-origin: 50% 0;
      animation: t-phases-in var(--duration-glass-unfold)
        var(--ease-glass-spring) backwards;
    }

    .t-phases-line {
      animation: t-phases-line calc(var(--duration-glass-unfold) * 2)
        var(--ease-emphasized) backwards;
      animation-delay: calc(var(--duration-glass-unfold) * 0.5);
    }

    .t-phase-node,
    .t-phase-name,
    .t-phase-off,
    .t-phase-state {
      animation: t-phase-in var(--duration-glass-unfold) var(--ease-emphasized)
        backwards;
      animation-delay: calc(
        var(--duration-glass-unfold) * 0.6 + var(--duration-glass-stagger) * 3 *
          var(--i)
      );
    }

    .t-phase-node {
      animation-name: t-phase-mark-in;
      animation-timing-function: var(--ease-glass-spring);
    }
  }

  @keyframes t-phases-in {
    from {
      opacity: 0;
      clip-path: inset(0 3% 60% round var(--radius-ticket-card));
      transform: translateY(-0.4rem);
    }

    to {
      clip-path: inset(0 round var(--radius-ticket-card));
    }
  }

  @keyframes t-phases-line {
    from {
      transform: scale(0);
    }
  }

  @keyframes t-phase-in {
    from {
      opacity: 0;
      transform: translateY(0.3rem);
    }
  }

  @keyframes t-phase-mark-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }
</style>
