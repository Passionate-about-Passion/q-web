---
// Hero shared by /our-team and /past-teams: the current-team group photo
// behind a dark overlay with a centered white H1 (the live header7/header65
// section), sized so the whole group always shows, melting into the 2027
// navy below (DESIGN.md NAVY-1).
import { Picture } from "../../lib/astro-assets";
import { TEAM_HERO_PHOTO, widePhotoSrc } from "../../lib/team-media";
import { resolveContentImage } from "../../lib/images";

interface Props {
  title: string;
  /** Payload Live Preview path for the title, e.g. "heading". */
  lpTitle?: string;
}

const { title, lpTitle } = Astro.props;

// Group photo used as the hero background on both live team pages: this is
// the LCP element on both routes, so it stays loading="eager"/fetchpriority
// "high" through the pipeline.
const backgroundImage = await resolveContentImage(
  TEAM_HERO_PHOTO,
  "team hero background",
);
const background = widePhotoSrc(TEAM_HERO_PHOTO);
---

<header class="team-hero">
  {
    backgroundImage ? (
      <Picture
        class="team-hero__image"
        src={backgroundImage}
        alt=""
        widths={[800, 1200, 1600]}
        sizes="132vw"
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        quality={80}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <img
        class="team-hero__image"
        src={background.src}
        srcset={background.srcset}
        sizes="132vw"
        alt=""
        width="1600"
        height="1066"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )
  }
  <div class="team-hero__overlay" aria-hidden="true"></div>
  <div class="team-hero__melt" aria-hidden="true">
    <div></div><div></div><div></div><div></div>
  </div>
  <div class="container team-hero__content">
    <h1 class="team-hero__title" data-lp={lpTitle}>{title}</h1>
  </div>
</header>
<div class="team-hero__seam" aria-hidden="true"></div>

<style>
  /* DESIGN.md NAVY-1: the live team hero (the 50% scrim, the centered
     white H1 at the site's H1 size) on the 2027 navy, with the group photo
     sized by the window's WIDTH so nobody is ever cut off: the group spans
     about 16% to 85% of the frame, so the photo is drawn 1/0.76 of the
     hero's width, centered, which leaves a little air at both sides. Its
     foot is anchored so the strip of pavement under the shoes ends the
     hero, and a short melt (stacked backdrop blurs under a navy wash)
     dissolves that strip into the page instead of ending on an edge. The
     hero is never taller than the photo allows (62vw), else the live
     min(100svh, 52rem). */
  .team-hero {
    position: relative;
    height: min(100svh, 52rem, 62vw);
    overflow: hidden;
    background: var(--q-night);
  }

  .team-hero__image {
    position: absolute;
    left: 50%;
    bottom: -11.4vw;
    width: calc(100% / 0.76);
    max-width: none;
    height: auto;
    aspect-ratio: 1600 / 1066;
    object-fit: cover;
    transform: translateX(-50%);
  }

  .team-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* The shared scrim token, same value the home hero uses (DESIGN.md COLOR-3). */
    background-color: var(--color-overlay);
  }

  /* The melt: four backdrop blurs, each stronger and masked to a lower
     band, and over them a navy wash along one eased OKLab curve. */
  .team-hero__melt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    z-index: 2;
    height: 5.4vw;
    pointer-events: none;
  }

  .team-hero__melt > div {
    position: absolute;
    inset: 0;
  }

  .team-hero__melt > div:nth-child(1) {
    -webkit-backdrop-filter: blur(1px);
    backdrop-filter: blur(1px);
    -webkit-mask: linear-gradient(
      transparent 0%,
      var(--color-black) 20%,
      var(--color-black) 40%,
      transparent 60%
    );
    mask: linear-gradient(
      transparent 0%,
      var(--color-black) 20%,
      var(--color-black) 40%,
      transparent 60%
    );
  }

  .team-hero__melt > div:nth-child(2) {
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    -webkit-mask: linear-gradient(
      transparent 20%,
      var(--color-black) 45%,
      var(--color-black) 60%,
      transparent 80%
    );
    mask: linear-gradient(
      transparent 20%,
      var(--color-black) 45%,
      var(--color-black) 60%,
      transparent 80%
    );
  }

  .team-hero__melt > div:nth-child(3) {
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    -webkit-mask: linear-gradient(transparent 40%, var(--color-black) 65%);
    mask: linear-gradient(transparent 40%, var(--color-black) 65%);
  }

  .team-hero__melt > div:nth-child(4) {
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    -webkit-mask: linear-gradient(transparent 60%, var(--color-black) 85%);
    mask: linear-gradient(transparent 60%, var(--color-black) 85%);
  }

  .team-hero__melt::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      in oklab 180deg,
      transparent 0%,
      color-mix(in oklab, var(--q-night) 8%, transparent) 15%,
      color-mix(in oklab, var(--q-night) 26%, transparent) 30%,
      color-mix(in oklab, var(--q-night) 52%, transparent) 45%,
      color-mix(in oklab, var(--q-night) 77%, transparent) 60%,
      color-mix(in oklab, var(--q-night) 93%, transparent) 74%,
      var(--q-night) 86%,
      var(--q-night) 100%
    );
  }

  /* A strip of the ground over the photo's clipped lower edge: the
     stacked backdrop blurs leave a faint line on that sub-pixel row. */
  .team-hero__seam {
    position: relative;
    z-index: 4;
    height: 16px;
    margin-block: -8px;
    background: var(--q-night);
  }

  /* The title sits on the sweatshirts, below the faces, at every width. */
  .team-hero__content {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: 21vw;
    transform: translateY(50%);
    text-align: center;
  }

  .team-hero__title {
    color: var(--color-text-inverse);
    text-wrap: balance;
  }

  /* The hero is 62vw tall on phones, so the title steps down with it. */
  @media (max-width: 767px) {
    .team-hero__title {
      font-size: clamp(1.5rem, 4.2vw, 2.5rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .team-hero__image {
      animation: team-hero-in var(--duration-glass-light) var(--ease-snappy)
        both;
    }
  }

  @keyframes team-hero-in {
    from {
      opacity: 0;
    }
  }
</style>
