---
// Hero shared by /our-team and /past-teams: the current-team group photo
// behind a dark overlay with a centered white H1 (the live header7/header65
// section), framed like the team's history page mockup and melting softly
// into the 2027 navy below (DESIGN.md NAVY-1).
import {
  TEAM_HERO_PHOTO,
  TEAM_HERO_SIZE,
  TEAM_HERO_SRCSET,
} from "../../lib/team-media";

interface Props {
  title: string;
  /** Payload Live Preview path for the title, e.g. "heading". */
  lpTitle?: string;
}

const { title, lpTitle } = Astro.props;
---

<header class="team-hero">
  {
    /* The LCP element on both team routes: eager, high priority, and the
      same srcset the pages preload (lib/team-media.ts). */
  }
  <img
    class="team-hero__image"
    src={`/media/${TEAM_HERO_PHOTO}`}
    srcset={TEAM_HERO_SRCSET}
    sizes="100vw"
    alt=""
    width={TEAM_HERO_SIZE.width}
    height={TEAM_HERO_SIZE.height}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="team-hero__overlay" aria-hidden="true"></div>
  <div class="team-hero__melt" aria-hidden="true"></div>
  <div class="container team-hero__content">
    <h1 class="team-hero__title" data-lp={lpTitle}>{title}</h1>
  </div>
</header>
<div class="team-hero__seam" aria-hidden="true"></div>

<style>
  /* DESIGN.md NAVY-1: the live team hero (the 50% scrim, the centered
     white H1 at the site's H1 size) on the 2027 navy, framed like the
     team's history page mockup: the photo spans the full width and shows
     the band between --crop-top and --crop-bottom of its height (the
     building above the heads and the road below the pavement are cut), so
     the whole group stands in the frame with the title on the
     sweatshirts. */
  .team-hero {
    --crop-top: 0.28;
    --crop-bottom: 0.12;
    position: relative;
    height: min(100svh, 52rem);
    overflow: hidden;
    background: var(--q-night);
  }

  .team-hero__image {
    --shown: calc(1 - var(--crop-top) - var(--crop-bottom));
    position: absolute;
    inset-inline: 0;
    top: calc(-100% * var(--crop-top) / var(--shown));
    width: 100%;
    height: calc(100% / var(--shown));
    max-width: none;
    object-fit: cover;
    object-position: center bottom;
  }

  .team-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* The shared scrim token, same value the home hero uses (DESIGN.md COLOR-3). */
    background-color: var(--color-overlay);
  }

  /* The melt: the photo goes soft and dark towards its lower edge in one
     long eased band (a single blur under an eased mask, with a navy wash
     on the same curve), so it melts into the page instead of ending on a
     line. */
  .team-hero__melt {
    --ease:
      transparent, color-mix(in srgb, var(--color-black) 4%, transparent) 10%,
      color-mix(in srgb, var(--color-black) 15%, transparent) 22%,
      color-mix(in srgb, var(--color-black) 34%, transparent) 35%,
      color-mix(in srgb, var(--color-black) 57%, transparent) 48%,
      color-mix(in srgb, var(--color-black) 78%, transparent) 60%,
      color-mix(in srgb, var(--color-black) 92%, transparent) 71%,
      var(--color-black) 82%;
    position: absolute;
    inset: auto 0 -2px;
    z-index: 2;
    height: 42%;
    pointer-events: none;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    -webkit-mask: linear-gradient(var(--ease));
    mask: linear-gradient(var(--ease));
    background: linear-gradient(
      in oklab 180deg,
      transparent 0%,
      color-mix(in oklab, var(--q-night) 6%, transparent) 14%,
      color-mix(in oklab, var(--q-night) 20%, transparent) 28%,
      color-mix(in oklab, var(--q-night) 40%, transparent) 42%,
      color-mix(in oklab, var(--q-night) 62%, transparent) 56%,
      color-mix(in oklab, var(--q-night) 81%, transparent) 70%,
      color-mix(in oklab, var(--q-night) 94%, transparent) 84%,
      var(--q-night) 100%
    );
  }

  /* A strip of the ground over the photo's clipped lower edge: the
     backdrop blur leaves a faint line on that sub-pixel row. */
  .team-hero__seam {
    position: relative;
    z-index: 4;
    height: 16px;
    margin-block: -8px;
    background: var(--q-night);
  }

  .team-hero__content {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    top: 50%;
    transform: translateY(-50%);
    text-align: center;
  }

  .team-hero__title {
    color: var(--color-text-inverse);
    text-wrap: balance;
  }

  /* Phones: trim the pavement, not the heads; the photo only goes soft
     below the feet. */
  @media (max-width: 767px) {
    .team-hero {
      --crop-top: 0.25;
      --crop-bottom: 0.13;
      height: min(62svh, 30rem);
    }

    .team-hero__content {
      top: 60%;
    }

    .team-hero__melt {
      height: 17%;
    }

    .team-hero__title {
      font-size: clamp(1.5rem, 4.2vw, 2.5rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .team-hero__image {
      animation: team-hero-in var(--duration-glass-light) var(--ease-snappy)
        both;
    }
  }

  @keyframes team-hero-in {
    from {
      opacity: 0;
    }
  }
</style>
